# Variable names. Every SIDEKICK_* variable in this file can also be set under
# its older INSTANT_* name (SIDEKICK_BACKEND_URL as INSTANT_BACKEND_URL, and so
# on), so an existing .env keeps working. When both are set, SIDEKICK_* wins.

# Public URLs. Change these when deploying behind a domain or proxy.
SIDEKICK_BACKEND_URL=http://localhost:8888
SIDEKICK_DASHBOARD_URL=http://localhost:3000
# S3_PUBLIC_ENDPOINT must be an origin without a path. Use a dedicated hostname or port.
# For Cloudflare R2, use the S3 API domain, not a custom domain (see README.md).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Domains used by the Caddy compose file. For production, point DNS at this host
# and update the public URLs above to use these domains with https://.
# These are only required if using docker-compose.with-caddy.yml
DASHBOARD_DOMAIN=localhost
BACKEND_DOMAIN=api.localhost
STORAGE_DOMAIN=files.localhost

# Required secrets. docker-compose.yml, docker-compose.with-caddy.yml and
# swarm.yml refuse to start until POSTGRES_PASSWORD, STORAGE_ACCESS_KEY and
# STORAGE_SECRET_KEY are set. Generate them once and keep them: changing them
# later locks the server out of the existing database and storage volumes.
#
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 32)" >> .env
#   echo "STORAGE_ACCESS_KEY=$(openssl rand -hex 16)" >> .env
#   echo "STORAGE_SECRET_KEY=$(openssl rand -hex 32)" >> .env
#
# Hex values are safe inside DATABASE_URL; avoid characters such as @ : / ?
# in a password you choose yourself. Only docker-compose.local.yml, which
# binds to 127.0.0.1 and is meant for local development, falls back to the
# well-known values "pass" and "rustfsadmin" when these are blank.

# Database. DATABASE_URL is inferred from these values inside docker-compose.
POSTGRES_USER=instant
POSTGRES_PASSWORD=
POSTGRES_DB=instant
# docker-compose.yml publishes Postgres on port 8890 of 127.0.0.1 only. Set an
# address such as 0.0.0.0 to reach it from other machines; Docker-published
# ports bypass host firewalls such as ufw. swarm.yml does not publish it.
# POSTGRES_BIND_ADDRESS=127.0.0.1
# The number of connections each instance will create to the database
# Ensure that postgres' `max_connections` is greater than CONNECTION_POOL_SIZE*<num instances>
CONNECTION_POOL_SIZE=20

# Object storage. The `storage` service runs RustFS (https://rustfs.com), an
# S3-compatible object store. The server's AWS credentials are taken from
# these values (required, see above).
# If using AWS S3, set STORAGE_ACCESS_KEY to your AWS Access Key ID
# and STORAGE_SECRET_KEY to your AWS Secret Access Key, and
# leave S3_ENDPOINT and S3_PUBLIC_ENDPOINT blank.
# These were called MINIO_ROOT_USER and MINIO_ROOT_PASSWORD. The old names
# are no longer read: an .env that only has them is refused with a message
# asking to rename them (see "Renaming the storage keys" in README.md).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
S3_BUCKET=instant-bucket
# Bucket for app backups. The createbuckets service creates it in RustFS.
# If you use AWS S3 instead, create this bucket yourself. If it is unset,
# backups are disabled and backup requests fail with a clear error.
S3_APP_BACKUPS_BUCKET=instant-backups
S3_ENDPOINT=http://storage:9000
AWS_REGION=us-east-1
# The compose files set AWS_REQUEST_CHECKSUM_CALCULATION=when_required on the
# server because RustFS 1.0.6 rejects backup uploads otherwise. Override it
# only if your object store needs the AWS SDK's default checksum mode.
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required

# Images. POSTGRES_IMAGE needs Postgres 17 with the pg_hint_plan and wal2json
# extensions. All three default to SidekickDB's images on ghcr.io/sidekickdb.
# SERVER_IMAGE and DASHBOARD_IMAGE default to the latest tag; set a version tag
# such as v2.0.1 to stay on one release. docker-compose.local.yml builds them
# instead and tags them sidekickdb-server:local and sidekickdb-dashboard:local.
# POSTGRES_IMAGE=ghcr.io/sidekickdb/postgresql:postgresql-17-pg-hint-plan
# SERVER_IMAGE=ghcr.io/sidekickdb/server:latest
# DASHBOARD_IMAGE=ghcr.io/sidekickdb/dashboard:latest
#
# STORAGE_IMAGE is the S3-compatible server; STORAGE_CLIENT_IMAGE creates the
# buckets and needs `sh` and the RustFS client `rc`. Both are pinned releases.
# Another S3-compatible server also needs its own environment and
# healthcheck in the compose file.
STORAGE_IMAGE=rustfs/rustfs:1.0.6
STORAGE_CLIENT_IMAGE=rustfs/rc:v0.1.38

# Server memory. SERVER_MEMORY_LIMIT is the server container's memory limit
# (compose mem_limit; deploy.resources.limits.memory in swarm.yml). JAVA_OPTS
# defaults to the flags below: the heap may use up to 60% of the container
# limit, and two native-memory bounds from upstream's own deployment cap cached
# NIO buffers and return freed native memory to the OS every 60 s. Setting
# JAVA_OPTS replaces all of these defaults, so repeat the ones you want to
# keep. Without a container limit the JVM sizes the heap from host memory.
# SERVER_MEMORY_LIMIT=2g
# JAVA_OPTS=-XX:MaxRAMPercentage=60 -Djdk.nio.maxCachedBufferSize=131072 -XX:TrimNativeHeapInterval=60000
# Each app with connected clients has a query cache. Unset, its limit is a
# quarter of the server's maximum heap, at most 500 MiB (about 300 MiB with the
# defaults above). Set a size in bytes, or with a k, m or g suffix. See
# "Server memory" in README.md.
# SIDEKICK_QUERY_CACHE_MAX_BYTES=256m

# DNS for the server's outbound requests (webhooks, OAuth discovery and keys).
# Unset uses DNS-over-HTTPS through Cloudflare and Google. Set a
# comma-separated list of DoH endpoints to use your own, or "system" to use
# only the system resolver. There is no automatic fallback to the system
# resolver: on a network that blocks DoH these requests fail until you set
# "system". With "system", names that exist only inside your network resolve
# too. Private and loopback addresses are rejected either way.
# SIDEKICK_DNS_OVER_HTTPS_URLS=system

# Runtime mode. "self-hosted" (the default in these compose files) switches
# off Instant Cloud operations and development-only behaviour; "default" is
# upstream's development behaviour. See "Runtime mode" in README.md.
# SIDEKICK_RUNTIME_MODE=default
# nREPL on port 6005 inside the server container is off in the self-hosted
# mode; set this to start it. Whoever connects can run any code in the server
# process, with the database credentials and the keys from override.edn. It
# listens on 127.0.0.1:6005 inside the server container, so only `docker exec`
# into that container reaches it: do not publish the port and do not set
# NREPL_BIND_ADDRESS. Leave it off unless you are debugging. With
# SIDEKICK_RUNTIME_MODE=default the server starts nREPL whatever this says
# (still on 127.0.0.1).
# SIDEKICK_NREPL=true

# Shutdown drain. A stopping server closes its WebSockets at a steady rate over
# this many seconds, so clients reconnect a few at a time instead of all at
# once. The compose files give the server 60 s to stop: keep this below about
# 35, or raise stop_grace_period too. A value that is not a whole number from
# 0 to 3600 stops the server at startup. See "Restarts and rolling updates" in
# README.md.
# SIDEKICK_SHUTDOWN_DRAIN_SECONDS=20

# Optional integrations.
STRIPE_API_KEY=

# Optional deployment superuser. This user can manage the entire self-hosted
# deployment. Restart the server after changing it.
SIDEKICK_SUPERUSER_EMAIL=

# Dashboard Google login. Create a Google OAuth Web application and set its
# authorized redirect URI to ${SIDEKICK_BACKEND_URL}/dash/oauth/callback.
# When these are blank the server does not contact Google at startup.
SIDEKICK_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=
SIDEKICK_DASHBOARD_GOOGLE_OAUTH_CLIENT_SECRET=

# Email. Provide a Postmark, SendGrid, or Resend token to send login magic codes.
# If none is set, one-time login codes will be printed to stdout
# from the server container.
#
# Set exactly one token, or set multiple and pick one with SIDEKICK_EMAIL_PROVIDER
# ("postmark", "sendgrid", or "resend"). Make sure the *_EMAIL_SENDER_EMAIL addresses
# below are verified senders/domains with your chosen provider.
#
# The sender and reply-to addresses have no built-in defaults, and empty values
# count as unset. If a token is set but a *_EMAIL_SENDER_EMAIL is not, the
# server logs a warning at startup and emails from that sender fail with an
# error. SIDEKICK_EMAIL_REPLY_TO is optional.
POSTMARK_TOKEN=
SENDGRID_TOKEN=
RESEND_TOKEN=
SIDEKICK_EMAIL_PROVIDER=
SIDEKICK_EMAIL_REPLY_TO=hello@example.com
SIDEKICK_DASHBOARD_EMAIL_SENDER_NAME=SidekickDB
SIDEKICK_DASHBOARD_EMAIL_SENDER_EMAIL=verify@example.com
# Emails to an app's users use the app's title as the sender name; this
# name is not used.
SIDEKICK_APP_EMAIL_SENDER_NAME=
SIDEKICK_APP_EMAIL_SENDER_EMAIL=verify@example.com
SIDEKICK_TEAM_EMAIL_SENDER_NAME=SidekickDB
SIDEKICK_TEAM_EMAIL_SENDER_EMAIL=teams@example.com
