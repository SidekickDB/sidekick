# Public URLs. Change these when deploying behind a domain or proxy.
INSTANT_BACKEND_URL=http://localhost:8888
INSTANT_DASHBOARD_URL=http://localhost:3000
# S3_PUBLIC_ENDPOINT must be an origin without a path. Use a dedicated hostname or port.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Domains used by the Caddy compose file. For production, point DNS at this host
# and update the public URLs above to use these domains with https://.
# These are only required if using docker-compose.with-caddy.yml
DASHBOARD_DOMAIN=localhost
BACKEND_DOMAIN=api.localhost
STORAGE_DOMAIN=files.localhost

# Database. DATABASE_URL is inferred from these values inside docker-compose.
POSTGRES_USER=instant
POSTGRES_PASSWORD=pleasegenerateapasswordhere
POSTGRES_DB=instant
# The number of connections each instance will create to the database
# Ensure that postgres' `max_connections` is greater than CONNECTION_POOL_SIZE*<num instances>
CONNECTION_POOL_SIZE=20

# Object storage. The `storage` service runs RustFS (https://rustfs.com), an
# S3-compatible object store. The server's AWS credentials are taken from
# these values. Replace them before deploying; do not keep the well-known
# rustfsadmin default.
# If using AWS S3, set STORAGE_ACCESS_KEY to your AWS Access Key ID
# and STORAGE_SECRET_KEY to your AWS Secret Access Key, and
# leave S3_ENDPOINT and S3_PUBLIC_ENDPOINT blank.
# Older .env files that set MINIO_ROOT_USER / MINIO_ROOT_PASSWORD still work
# with the docker-compose files; the STORAGE_* names take precedence.
STORAGE_ACCESS_KEY=pleasegenerateauserhere
STORAGE_SECRET_KEY=pleasegenerateapasswordhere
S3_BUCKET=instant-bucket
# Bucket for app backups. The createbuckets service creates it in RustFS.
# If you use AWS S3 instead, create this bucket yourself. If it is unset,
# backups are disabled and backup requests fail with a clear error.
S3_APP_BACKUPS_BUCKET=instant-backups
S3_ENDPOINT=http://storage:9000
AWS_REGION=us-east-1

# Images. POSTGRES_IMAGE needs Postgres 17 with the pg_hint_plan and wal2json
# extensions. SERVER_IMAGE and DASHBOARD_IMAGE default to the upstream images in
# docker-compose.yml; docker-compose.local.yml builds them and tags them
# sidekickdb-server:local and sidekickdb-dashboard:local.
# POSTGRES_IMAGE=ghcr.io/instantdb/postgresql:postgresql-17-pg-hint-plan
# SERVER_IMAGE=
# DASHBOARD_IMAGE=
#
# STORAGE_IMAGE is the S3-compatible server; STORAGE_CLIENT_IMAGE creates the
# buckets and needs `sh` and the RustFS client `rc`. Both are pinned releases.
# Another S3-compatible server also needs its own environment and
# healthcheck in the compose file.
STORAGE_IMAGE=rustfs/rustfs:1.0.6
STORAGE_CLIENT_IMAGE=rustfs/rc:v0.1.38

# Optional integrations.
STRIPE_API_KEY=

# Optional deployment superuser. This user can manage the entire self-hosted
# deployment. Restart the server after changing it.
INSTANT_SUPERUSER_EMAIL=

# Dashboard Google login. Create a Google OAuth Web application and set its
# authorized redirect URI to ${INSTANT_BACKEND_URL}/dash/oauth/callback.
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_SECRET=

# Email. Provide a Postmark, SendGrid, or Resend token to send login magic codes.
# If none is set, one-time login codes will be printed to stdout
# from the server container.
#
# Set exactly one token, or set multiple and pick one with INSTANT_EMAIL_PROVIDER
# ("postmark", "sendgrid", or "resend"). Make sure the *_EMAIL_SENDER_EMAIL addresses
# below are verified senders/domains with your chosen provider.
#
# The sender and reply-to addresses have no built-in defaults, and empty values
# count as unset. If a token is set but a *_EMAIL_SENDER_EMAIL is not, the
# server logs a warning at startup and emails from that sender fail with an
# error. INSTANT_EMAIL_REPLY_TO is optional.
POSTMARK_TOKEN=
SENDGRID_TOKEN=
RESEND_TOKEN=
INSTANT_EMAIL_PROVIDER=
INSTANT_EMAIL_REPLY_TO=hello@example.com
INSTANT_DASHBOARD_EMAIL_SENDER_NAME=Instant
INSTANT_DASHBOARD_EMAIL_SENDER_EMAIL=verify@example.com
INSTANT_APP_EMAIL_SENDER_NAME=Instant
INSTANT_APP_EMAIL_SENDER_EMAIL=verify@example.com
INSTANT_TEAM_EMAIL_SENDER_NAME=Instant
INSTANT_TEAM_EMAIL_SENDER_EMAIL=teams@example.com
