ARG NODE_VERSION=22.22.2-slim

FROM node:${NODE_VERSION} AS dependencies

WORKDIR /monorepo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./


# Install project dependencies with frozen lockfile for reproducible builds
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/usr/local/share/.cache/yarn \
    --mount=type=cache,target=/root/.local/share/pnpm/store \
    corepack enable pnpm && pnpm install --frozen-lockfile;

FROM node:${NODE_VERSION} AS pruner

WORKDIR /monorepo

COPY --from=dependencies /monorepo/node_modules ./node_modules

COPY . .
RUN corepack enable pnpm;
RUN pnpm turbo prune instant-www --docker

FROM node:${NODE_VERSION} AS builder
WORKDIR /monorepo
ARG NEXT_PUBLIC_SELF_HOSTED=true
ENV NEXT_PUBLIC_SELF_HOSTED=${NEXT_PUBLIC_SELF_HOSTED}
COPY --from=pruner /monorepo/out/json/ .
RUN corepack enable pnpm
RUN pnpm install --frozen-lockfile

COPY --from=pruner /monorepo/out/full/ .
COPY tsconfig.base.json ./

RUN pnpm install --frozen-lockfile

RUN pnpm turbo build

# Production runner
FROM node:${NODE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Each of these can also be set under its SIDEKICK_ name (SIDEKICK_API_URI,
# SIDEKICK_BACKEND_URL, SIDEKICK_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID), which wins.
ENV INSTANT_API_URI=
ENV INSTANT_BACKEND_URL=
# Only its presence is used: the login page shows "Continue with Google" when set.
ENV INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=
ARG NEXT_PUBLIC_SELF_HOSTED=true
ENV NEXT_PUBLIC_SELF_HOSTED=${NEXT_PUBLIC_SELF_HOSTED}

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy the standalone output
COPY --from=builder /monorepo/www/.next/standalone ./
# Copy static assets and public files
COPY --from=builder /monorepo/www/.next/static ./www/.next/static
# SidekickDB: only the public files the dashboard and the docs load. The rest of
# public/ is Instant's website (essay media, newsletters, marketing images,
# Instant's icons, the sitemap and feeds). A new file the dashboard loads must be
# added here, and its folder to selfHostedStaticDirs in www/next.config.js.
# docs, docs.md and llm-rules are written by the build (prebuild), llms.txt and
# llms-full.txt after it (postbuild); a missing one fails the COPY.
COPY --from=builder /monorepo/www/public/fonts ./www/public/fonts
COPY --from=builder /monorepo/www/public/img/docs ./www/public/img/docs
COPY --from=builder /monorepo/www/public/img/*.svg ./www/public/img/
COPY --from=builder /monorepo/www/public/docs ./www/public/docs
COPY --from=builder /monorepo/www/public/llm-rules ./www/public/llm-rules
COPY --from=builder /monorepo/www/public/docs.md /monorepo/www/public/llms.txt /monorepo/www/public/llms-full.txt /monorepo/www/public/native-file-system-adapter-sw.js /monorepo/www/public/publicSelfHostedVariables.js ./www/public/

COPY <<'EOF' /app/start.sh
#!/bin/sh
set -eu

node <<'NODE'
const fs = require('fs');

// A setting can be given under its SIDEKICK_ name or its older INSTANT_ name.
// The SIDEKICK_ name wins; a blank value counts as unset.
const env = (name) =>
  (process.env[`SIDEKICK_${name}`] || '').trim() ||
  (process.env[`INSTANT_${name}`] || '').trim();

const apiURI = env('API_URI') || env('BACKEND_URL');

try {
  const url = new URL(apiURI);
  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
    throw new Error('Unsupported protocol');
  }
} catch (_e) {
  console.error(
    'SIDEKICK_API_URI or SIDEKICK_BACKEND_URL (or the older INSTANT_ names) must be a valid HTTP(S) URL.',
  );
  process.exit(1);
}

const dashboardGoogleOAuth = Boolean(env('DASHBOARD_GOOGLE_OAUTH_CLIENT_ID'));

fs.writeFileSync(
  '/app/www/public/publicSelfHostedVariables.js',
  `window.__instantConfig = ${JSON.stringify({ apiURI, dashboardGoogleOAuth })};\n`,
);
NODE

exec node www/server.js
EOF

RUN chmod +x /app/start.sh && chown -R nextjs:nodejs /app/www/public /app/start.sh

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["/app/start.sh"]
