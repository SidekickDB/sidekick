{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch -r)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git fetch origin)",
      "Bash(git fetch upstream)",
      "Bash(git merge-base:*)",
      "Bash(git cherry:*)",
      "Bash(gh repo set-default --view)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(node scripts/upstream/check.mjs:*)"
    ],
    "ask": ["Bash(gh pr merge:*)"],
    "deny": [
      "Bash(git push upstream:*)",
      "Bash(git push *instantdb/instant*)",
      "Bash(gh pr create *-R instantdb/instant*)",
      "Bash(gh pr create *--repo instantdb/instant*)",
      "Bash(gh pr comment *-R instantdb/instant*)",
      "Bash(gh pr comment *--repo instantdb/instant*)",
      "Bash(gh pr review *-R instantdb/instant*)",
      "Bash(gh pr review *--repo instantdb/instant*)",
      "Bash(gh pr edit *-R instantdb/instant*)",
      "Bash(gh pr edit *--repo instantdb/instant*)",
      "Bash(gh pr close *-R instantdb/instant*)",
      "Bash(gh pr close *--repo instantdb/instant*)",
      "Bash(gh pr reopen *-R instantdb/instant*)",
      "Bash(gh pr reopen *--repo instantdb/instant*)",
      "Bash(gh pr merge *-R instantdb/instant*)",
      "Bash(gh pr merge *--repo instantdb/instant*)",
      "Bash(gh issue create *-R instantdb/instant*)",
      "Bash(gh issue create *--repo instantdb/instant*)",
      "Bash(gh issue comment *-R instantdb/instant*)",
      "Bash(gh issue comment *--repo instantdb/instant*)",
      "Bash(gh issue edit *-R instantdb/instant*)",
      "Bash(gh issue edit *--repo instantdb/instant*)",
      "Bash(gh issue close *-R instantdb/instant*)",
      "Bash(gh issue close *--repo instantdb/instant*)",
      "Bash(gh issue reopen *-R instantdb/instant*)",
      "Bash(gh issue reopen *--repo instantdb/instant*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/upstream-write-guard.mjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
