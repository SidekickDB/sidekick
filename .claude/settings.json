{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(git cherry:*)",
      "Bash(gh repo set-default --view)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(node scripts/upstream/check.mjs:*)"
    ],
    "deny": [
      "Bash(git push upstream:*)",
      "Bash(gh pr merge --squash:*)",
      "Bash(gh pr merge --rebase:*)"
    ]
  }
}
